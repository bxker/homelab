# Terraform state (contains sensitive values)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl

# Environment / secrets
.env
*.tfvars
!terraform.tfvars.example

# Large binaries
*.iso

# Helm dependency artifacts (ArgoCD runs `helm dependency build` itself)
kubernetes/apps/**/charts/
kubernetes/apps/**/Chart.lock

# Saved plans (mise run infra) can contain secrets
terraform/tfplan

# SSH host keys accepted on first connect (ansible/ansible.cfg)
ansible/known_hosts
ansible/known_hosts.old

# macOS Finder metadata
.DS_Store
